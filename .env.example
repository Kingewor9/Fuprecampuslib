# Telegram Bot token from @BotFather
BOT_TOKEN=

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=campuslib

# The private Telegram channel used as file storage.
# The bot must be an admin of this channel.
# Use the numeric channel ID, e.g. -1001234567890
STORAGE_CHANNEL_ID=

# Comma-separated Telegram user IDs allowed to use admin upload flow
# e.g. ADMIN_IDS=123456789,987654321
ADMIN_IDS=
